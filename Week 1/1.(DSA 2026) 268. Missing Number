# Time-Complexity : O(N)
# Space-Complexity : O(1)
---------------------------------------------------------
class Solution:
    def missingNumber(self, nums: List[int]) -> int:
        length = len(nums)
        xor1 = 0
        for i in range(1,length+1):
            xor1 ^= i
        for i in range(length):
            xor1 ^= nums[i]
        
        return xor1
